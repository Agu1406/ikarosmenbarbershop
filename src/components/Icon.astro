---
/**
 * Icono Phosphor incrustado como SVG en el build.
 * No hay petición a ninguna API externa en el navegador.
 */
import ph from "@iconify-json/ph/icons.json";

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const icon = (ph.icons as Record<string, { body: string }>)[name];
if (!icon) throw new Error(`Icono Phosphor no encontrado: ${name}`);
const box = ph.width ?? 256;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${box} ${box}`}
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
