---
/**
 * Motivo geométrico de temporada (estrella de latón).
 * Solo visible con html[data-season="navidad"]. aria-hidden: decorativo.
 */
---

<span class="season-mark" aria-hidden="true">
  <svg class="season-mark-icon" viewBox="0 0 24 24" width="18" height="18" focusable="false">
    <path
      fill="currentColor"
      d="M12 1.5 13.8 8.2 20.5 10 13.8 11.8 12 18.5 10.2 11.8 3.5 10 10.2 8.2Z"
    ></path>
  </svg>
</span>
