---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Services from "../components/Services.astro";
import Tour from "../components/Tour.astro";
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
import { getPhoto } from "../lib/photos";

// Imagen para compartir: la foto del hero si existe (1200x630).
const hero = getPhoto("hero");
const og = hero
  ? await getImage({ src: hero, width: 1200, height: 630, format: "jpg", fit: "cover" })
  : undefined;
const ogImage = og ? new URL(og.src, Astro.site).href : undefined;
---

<Base ogImage={ogImage} jsonLd>
  <Hero />
  <TrustStrip />
  <Services />
  <Tour />
  <section class="section on-charcoal" id="productos" aria-labelledby="productos-title">
    <div class="wrap section-head">
      <p class="eyebrow">STMNT</p>
      <h2 id="productos-title" class="display">Productos para casa</h2>
      <p class="lead">
        Champú, barba y peinado STMNT. Se compran en la barbería o se envían a la ciudad de Madrid.
        Los precios llevan el IVA incluido.
      </p>
      <p><a class="btn btn-primary" href="/productos">Ver productos</a></p>
    </div>
  </section>
  <About />
  <Gallery />
  <Reviews />
  <Faq />
  <Contact />
</Base>
